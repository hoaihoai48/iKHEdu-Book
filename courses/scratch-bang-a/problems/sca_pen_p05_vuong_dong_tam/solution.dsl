when [1 v] key pressed
erase all
set pen color to [#0055ff]
set pen size to (3)

pen up
go to x: (-30) y: (30)
point in direction (90)
pen down
repeat (4)
    move (60) steps
    turn right (90) degrees
end

pen up
go to x: (-50) y: (50)
point in direction (90)
pen down
repeat (4)
    move (100) steps
    turn right (90) degrees
end

pen up
go to x: (-70) y: (70)
point in direction (90)
pen down
repeat (4)
    move (140) steps
    turn right (90) degrees
end
